# OpenAI (필수)
OPENAI_API_KEY=

# 임베딩: openai(배포 기본) | huggingface(로컬 BGE-M3 평가)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_MODEL=BAAI/bge-m3

# CORS (쉼표 구분). Vercel 배포 URL을 추가하세요.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LangSmith (선택)
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=hotel-ai

# 실메일 수신/발송 (이번 데모 공개 범위 밖, 로컬 전용)
# GMAIL_SENDER=
# GMAIL_APP_PASSWORD=
# GMAIL_INBOX_SUBJECT_TAG=[hotel]
# GMAIL_INBOX_MAILBOX=INBOX

# 규정 문서 LlamaCloud 파싱 (로컬 인덱싱 전용)
# LLAMA_CLOUD_API_KEY=

# Chroma 경로 (선택, 기본: ./chroma_db)
# CHROMA_DB_PATH=
# CHROMA_COLLECTION_NAME=guideline_collection
